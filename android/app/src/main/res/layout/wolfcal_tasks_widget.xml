<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/wolfcal_widget_bg"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp">

        <TextView
            android:id="@+id/tasks_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tarefas"
            android:textColor="#E6E8EF"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tasks_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:textColor="#9AA3B2"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tasks_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/wolfcal_button"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="+"
            android:textColor="#AFC3FF"
            android:textSize="18sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="4dp">

        <ListView
            android:id="@+id/tasks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"/>

        <TextView
            android:id="@+id/tasks_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="12dp"
            android:text="Sem tarefas por fazer"
            android:textColor="#9AA3B2"
            android:textSize="13sp"/>
    </FrameLayout>
</LinearLayout>
